ifeq "$(shell if [ -r ../Makefile.include ]; then echo yes; fi)" "yes"
include ../Makefile.include
else
ifeq "$(shell if [ -r $(ALPINO_HOME)/Makefile.include ]; then echo yes; fi)" "yes"
include $(ALPINO_HOME)/Makefile.include
endif
endif

sents = $(wildcard [CDEILPUWX]/*.sents)
pls = $(sents:%.sents=%.pl)

sents: C D E I L P U W X

pl: $(pls)



C_treebank = ../Treebank/cdb
C_pattern = 
D_treebank = ../Treebank/LassySmall
D_pattern = dpc
E_treebank = ../Treebank/LassySmall
E_pattern = WR-P-E
I_treebank = ../Treebank/LassySmall
I_pattern = WR-P-P-I
L_treebank = ../Treebank/LassySmall
L_pattern = WR-P-P-L
P_treebank = ../Treebank/LassySmall
P_pattern = WR-P-P-H
U_treebank = ../Treebank/LassySmall
U_pattern = WS-U-E-A
W_treebank = ../Treebank/LassySmall
W_pattern = wiki
X_treebank = ../Treebank/extra
X_pattern = 

C_name = c
D_name = d
E_name = d
I_name = i
L_name = l
P_name = p
U_name = u
W_name = w
X_name = x

C D E I L P U W X: 
	mkdir -p ${@}
	( cd ${${@}_treebank}; \
          ls -v ${${@}_pattern}*.xml |\
          xargs dtxslt -s\
          ${ALPINO_HOME}/TreebankTools/stylesheets/dt2sent_with_key.xsl |\
          sed -e 's/\[/\\\[/g' \
              -e 's/\]/\\\]/g' \
        ) |\
	( cd ${@} ; \
          ../split_in_parts -o ${${@}_name} -p 99 -z \
        )

%.pl : %.sents
	echo ":- module(alpino_suite,[ sentence/2 ])." > $*.pl
	echo >> $*.pl
	cat $< |\
	sed -e "s/| /|/" \
            -e "s/  *$$//" \
        | $(HDRUG) -notk -l $(ALPINO_HOME)/src/utils -l $(ALPINO_HOME)/Suites/create_pl_suite \
                 -cmd "to_suite(key)" | \
        sed -e 's/^my_sentence/sentence/' >>$*.pl
